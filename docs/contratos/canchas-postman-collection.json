            "url": {
              "raw": "{{gateway}}/api/reportes/ocupacion?desde={{inicioMes}}&hasta={{finMes}}",
              "host": ["{{gateway}}"],
              "path": ["api", "reportes", "ocupacion"],
              "query": [
                { "key": "desde", "value": "{{inicioMes}}" },
                { "key": "hasta", "value": "{{finMes}}" }
              ]
            },
            "description": "horasDisponibles = (horaCierre - horaApertura) x dias del rango. Ambos extremos inclusivos.\nporcentajeOcupacion con un decimal, redondeo HALF_UP.\nCuenta CONFIRMADA y FINALIZADA; excluye CANCELADA."
          }
        },
        {
          "name": "Reservas por periodo",
