<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Esqueleto generado con Spring Initializr por URL (start.spring.io), nunca con mvn
	  en el host. La version de Spring Boot se fija a 3.5.3 (ver CLAUDE.md seccion 3):
	  Initializr solo ofrece la rama 4.x, y springdoc-openapi 2.8.6 esta construido para
	  Spring Framework 6. Con el parent 4.x, Initializr entrega ademas
	  spring-boot-starter-webmvc y spring-boot-starter-webmvc-test, que no existen en
	  3.5.3: se reemplazan por spring-boot-starter-web y spring-boot-starter-test, los
	  mismos que usan los otros tres microservicios.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/>
	</parent>

	<groupId>ec.ups.dae</groupId>
	<artifactId>ms-reportes</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ms-reportes</name>
	<description>Microservicio de reportes de ocupacion, reservas y cancelaciones</description>

	<properties>
		<java.version>21</java.version>
		<springdoc.version>2.8.6</springdoc.version>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>

	<!--
	  SIN spring-boot-starter-data-jpa y SIN el driver de PostgreSQL: ms-reportes no tiene
	  base de datos propia (CLAUDE.md seccion 3, design D-01). Al faltar la dependencia no
	  hay DataSource que autoconfigurar ni que excluir, y leer canchas_db o reservas_db es
	  imposible por construccion, no por disciplina.

	  SIN spring-boot-starter-validation: los tres endpoints son GET con dos parametros de
	  consulta, no hay cuerpo de peticion que anotar con @Valid (design seccion 4.3).
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Agregadas a mano: no estan en el catalogo de Spring Initializr. Mismas
		     versiones que los otros tres microservicios, para que los cuatro validen el
		     mismo token igual. El cliente HTTP hacia ms-canchas y ms-reservas es el
		     RestClient que ya trae spring-boot-starter-web: no se agrega ninguna libreria
		     para eso. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
